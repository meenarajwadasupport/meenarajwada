@echo off
cd /d "%~dp0"
echo Cleaning git lock...
if exist ".git\index.lock" del /f ".git\index.lock"
echo Adding all changes...
git add -A
echo Committing...
git commit -m "fix: Google OAuth restored, track order, order numbers, shop price filter, admin error handling, mobile nav"
echo Pushing to GitHub...
git push
echo.
echo Done! Vercel will auto-deploy in ~1 minute.
pause
