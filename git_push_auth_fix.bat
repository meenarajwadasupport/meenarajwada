@echo off
cd /d "%~dp0"
echo Cleaning git lock...
if exist ".git\index.lock" del /f ".git\index.lock"
echo Adding changes...
git add -A
echo Committing...
git commit -m "fix: auth — remove Google OAuth, fix email redirect to production, add /auth/callback page, store email in profile"
echo Pushing to GitHub...
git push
echo Done! Now go to Vercel and redeploy.
pause
